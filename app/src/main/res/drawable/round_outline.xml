<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Transparent or filled background inside the layout -->
    <solid android:color="@android:color/transparent" />

    <!-- The outline stroke (width and color) -->
    <stroke
        android:width="2dp"
        android:color="#C4C4C4" /> <!-- Replace with your color -->

    <!-- How round you want the corners to be -->
    <corners android:radius="16dp" />

</shape>

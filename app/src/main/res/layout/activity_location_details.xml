<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".LocationDetailsActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_outline"
            android:backgroundTint="@color/purple_500">


            <TextView
                android:id="@+id/locationDName"
                android:drawableStart="@drawable/ic_store_dark"
                android:drawablePadding="10dp"
                android:layout_marginEnd="25dp"
                android:layout_toStartOf="@+id/locationBt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginStart="25dp"
                android:layout_marginTop="25dp"
                android:text="Name"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/locationDAdress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/locationDName"
                android:layout_alignParentStart="true"
                android:layout_marginStart="25dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="25dp"
                android:layout_toStartOf="@+id/locationBt"
                android:drawableStart="@drawable/ic_location_outlined_dark"
                android:drawablePadding="10dp"
                android:text="Address"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/locationDType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/locationDAdress"
                android:layout_alignParentStart="true"
                android:layout_marginStart="25dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="25dp"
                android:layout_marginEnd="25dp"
                android:layout_toStartOf="@+id/locationBt"
                android:drawableStart="@drawable/ic_assignment_dark"
                android:drawablePadding="10dp"
                android:text="Description"
                android:textSize="20dp" />

            <Button
                android:id="@+id/locationBt"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="25dp"
                app:icon="@drawable/ic_location">

            </Button>


        </RelativeLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/locationProductsRV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>